{
  "name": "jeton-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "pnpm gen:api && tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
