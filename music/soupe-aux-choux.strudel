// "La Soupe aux choux" — hommage
//
// NOTE: the film's theme (Raymond Lefèvre, 1981) is still under copyright, so
// this is an ORIGINAL tune written in its spirit — a bouncy, cheeky synth
// melody plus a "cosmic" interlude for La Denrée's flying saucer — not a
// transcription of the real theme. Swap `melA` for your own transcription if
// you hold the rights.
//
// Play it: paste into https://strudel.cc, or `nix run ./music` and pick it.
// Form: Space(4) A(8) A(8) Space(4) A(8)   — 4/4 at 116 BPM, 1 bar = 1 cycle

// ---- Village theme: cheeky, bouncy, F major ----
//   F                       F
const melA = `<
  [f4 a4 c5 a4 f5@2 e5 d5]
  [c5@2 a4 c5 bb4@2 g4@2]
  [g4 bb4 d5 bb4 g5@2 f5 e5]
  [f5@4 c5@2 ~@2]
  [d5 d5 f5 d5 c5@2 a4 c5]
  [bb4 bb4 d5 bb4 a4@2 f4 a4]
  [g4 a4 bb4 c5 e5@2 g5 e5]
  [f5@2 c5 a4 f4@2 ~@2]
>`
//            F  F  Gm C  Dm Bb C  F
const roots = "<41 41 43 48 38 46 48 41>"

const villageLead = note(melA).s("sawtooth")
  .lpf(1800).lpq(6).gain(.25).decay(.15).sustain(.5)
  .vib("5:.15")                                  // wobbly, a bit tipsy
const villageBass = note("[0 7]*2".add(roots)).s("triangle")
  .gain(.55).decay(.1).sustain(.3)               // oom-pah
const villageDrums = s("bd ~ bd ~, ~ hh ~ hh, ~ ~ ~ [~ cp]").gain(.4)

const village = stack(villageLead, villageBass, villageDrums)

// ---- Space interlude: the saucer lands in the cabbage patch ----
// diatonic triads in F major: F  Dm  Bb  C
const space = stack(
  n("[0 2 4 7 4 2 0 2]".add("<0 5 3 4>")).scale("F4:major")
    .s("sine").gain(.3).delay(.4).delaytime(.1875).delayfeedback(.45),
  n("[0,2,4]".add("<0 5 3 4>")).scale("F3:major")
    .s("sawtooth").lpf(sine.range(300, 1600).slow(4)).gain(.18)
    .attack(.4).release(.6),
  note("<77 [~ 84] 74 [79 ~ 72]>").s("sine")      // little alien "bleeps"
    .penv(12).pdecay(.08).gain(.15).room(.4)
)

arrange([4, space], [8, village], [8, village], [4, space], [8, village])
  .cpm(116 / 4)
